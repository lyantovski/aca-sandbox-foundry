# Local development only. Copy to .env and replace required values.
AZURE_OPENAI_ENDPOINT=https://replace-me.openai.azure.com
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Shared A2A authentication remains server-side in the BFF.
A2A_AUTH_ENABLED=false
A2A_AUTH_TOKEN=

# Optional ACA Sandbox configuration.
AZURE_SUBSCRIPTION_ID=
ACA_SANDBOX_RESOURCE_GROUP=
ACA_SANDBOX_GROUP_NAME=
ACA_SANDBOXGROUP_REGION=eastus2
ACA_SANDBOX_BROKER_TOKEN=

# Local mode defaults.
CONTENT_FACTORY_MODE=lab
AZURE_STORAGE_CONNECTION_STRING=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
