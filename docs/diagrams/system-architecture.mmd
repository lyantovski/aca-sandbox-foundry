flowchart TD
    subgraph ClientLayer["User Browser and Edge"]
        User["User"]
        Browser["Browser running DevUI JavaScript<br/>workflow orchestrator"]
        AGC["Application Gateway for Containers"]
        Entra["Microsoft Entra ID"]
    end
    subgraph WebLayer["AKS Web Layer"]
        DevUI["DevUI NGINX<br/>static HTML and JavaScript"]
        OAuth["OAuth2 Proxy"]
        BFF["Backend for Frontend"]
    end
    subgraph GovernanceLayer["AI Governance"]
        APIMAgents["APIM governed A2A APIs"]
        APIMModels["APIM model gateway<br/>/openai"]
        Registry["Foundry custom-agent registry"]
        Models["Foundry Models"]
    end
    subgraph AgentLayer["AKS Agent Runtime"]
        Research["Research Agent"]
        Creator["Creator Agent"]
        Podcaster["Podcaster Agent"]
        Broker["Sandbox Broker"]
        Collector["OpenTelemetry Collector"]
    end
    subgraph DataLayer["External Execution and Data"]
        Sandboxes["ACA Sandbox Group"]
        Sources["Approved web sources"]
        Blob[("Private Blob Storage")]
        Insights[("Application Insights")]
    end

    User --> Browser
    Browser -->|"GET / and Entra session"| AGC
    AGC -->|"GET /"| DevUI
    DevUI -.->|"HTML and JavaScript"| Browser
    Browser -->|"same-origin /api calls"| AGC
    AGC -->|"/api and /oauth2"| OAuth
    OAuth -.->|"302 OIDC authorization request"| Browser
    Browser <-->|"sign-in and authorization"| Entra
    Browser -.->|"callback through AGC"| OAuth
    OAuth -->|"trusted identity headers"| BFF
    BFF -->|"research, creator, podcaster A2A"| APIMAgents
    Registry -.->|"stores and invokes governed URLs"| APIMAgents
    APIMAgents -->|"private origin"| Research
    APIMAgents -->|"private origin"| Creator
    APIMAgents -->|"private origin"| Podcaster
    Research -->|"sandbox task"| Broker
    Broker -->|"create and execute"| Sandboxes
    Sandboxes -->|"allowlisted HTTPS"| Sources
    Research -->|"model inference"| APIMModels
    Creator -->|"model inference"| APIMModels
    Podcaster -->|"model and TTS inference"| APIMModels
    APIMModels -->|"managed identity"| Models
    Podcaster -->|"workload identity"| Blob
    Research -.->|"OTLP"| Collector
    Creator -.->|"OTLP"| Collector
    Podcaster -.->|"OTLP"| Collector
    Broker -.->|"OTLP"| Collector
    BFF -.->|"OTLP"| Collector
    Collector -->|"telemetry export"| Insights
    APIMAgents -.->|"diagnostics"| Insights
    APIMModels -.->|"tokens and diagnostics"| Insights
